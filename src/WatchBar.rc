// ============================================================================
// WatchBar - PE resources (VERSIONINFO + manifest).
//
// The version values are passed in by build.bat from WATCHBAR_VERSION in
// Config.h, so the file properties and the in-game log banner cannot drift
// apart. The manifest (resource id 2, the DLL one) declares an ordinary
// asInvoker module; the loader ignores a DLL's manifest.
//
// Both exist so an unsigned, injected DLL still carries the provenance data
// every ordinary Windows module has. Compiling this file by hand without the
// /d switches yields 0.0.0 - always build through build.bat.
// ============================================================================

#include <winresrc.h>

#ifndef WB_VER_STR
#define WB_VER_STR "0.0.0"
#endif
#ifndef WB_VER_NUM
#define WB_VER_NUM 0,0,0,0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WB_VER_NUM
PRODUCTVERSION WB_VER_NUM
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WatchBar project"
            VALUE "FileDescription",  "WatchBar - in-game spectator board for Yuri's Revenge"
            VALUE "FileVersion",      WB_VER_STR
            VALUE "InternalName",     "WatchBar"
            VALUE "LegalCopyright",   "WatchBar contributors. Licensed under GPL-3.0."
            VALUE "OriginalFilename", "WatchBar.dll"
            VALUE "ProductName",      "WatchBar"
            VALUE "ProductVersion",   WB_VER_STR
            VALUE "Comments",         "Syringe plugin for Yuri's Revenge 1.001, loaded by Syringe.exe into gamemd.exe with -i=WatchBar.dll. Open source: https://github.com/Clarissia117/WatchBar"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Resource id 2 is the manifest id a DLL uses (id 1 is the EXE one).
2 RT_MANIFEST "WatchBar.manifest"
